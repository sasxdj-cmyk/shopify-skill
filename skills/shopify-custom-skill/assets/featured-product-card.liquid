{%- comment -%}
  Product card used by sections/section-template.liquid.
  Place this file in snippets/featured-product-card.liquid

  Accepts:
    product     - product object (required)
    section_id  - section id, used only for debugging (optional)

  Escaping: every text sink uses escape, the image goes through image_url/image_tag,
  the variant id is an integer and is printed unquoted only inside a data attribute
  that the section's script reads with Number().
{%- endcomment -%}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign image = product.featured_image
-%}

<article class="featured-card">
  <a class="featured-card__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    {%- if image -%}
      {{ image
        | image_url: width: 800
        | image_tag:
            loading: 'lazy',
            widths: '200,300,400,600,800',
            sizes: '(min-width: 990px) 30vw, 45vw',
            alt: '',
            class: 'featured-card__image' }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'featured-card__image featured-card__image--placeholder' }}
    {%- endif -%}
  </a>

  <h3 class="featured-card__title">
    <a href="{{ product.url }}">{{ product.title | escape }}</a>
  </h3>

  <p class="featured-card__price">
    {%- if product.compare_at_price > product.price -%}
      <s>{{ product.compare_at_price | money }}</s>
      <span class="visually-hidden">{{ 'products.product.sale_price' | t }}</span>
    {%- endif -%}
    <span>{{ product.price | money }}</span>
  </p>

  {%- if variant -%}
    <form data-quick-add data-variant-id="{{ variant.id }}">
      <input type="hidden" name="id" value="{{ variant.id }}">
      <button
        type="submit"
        class="featured-card__button"
        {% unless variant.available %}disabled{% endunless %}
      >
        {%- if variant.available -%}
          {{ 'products.product.add_to_cart' | t }}
        {%- else -%}
          {{ 'products.product.sold_out' | t }}
        {%- endif -%}
      </button>
    </form>
  {%- endif -%}
</article>
